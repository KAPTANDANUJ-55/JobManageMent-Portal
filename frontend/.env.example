# ---------------------------------------------------------------------------
# Frontend environment configuration
# Copy this file to `.env` and adjust. Vite only exposes vars prefixed VITE_.
# ---------------------------------------------------------------------------

# true  -> all data comes from the in-browser mock backend (src/api/mock).
#          Use this while the Spring Boot API is still being built.
# false -> real HTTP calls go to VITE_API_BASE_URL.
VITE_USE_MOCKS=true

# Base path for API requests. Left as /api so the Vite dev-server proxy
# (see vite.config.js) forwards to Spring Boot without any CORS setup.
VITE_API_BASE_URL=/api

# Where the dev-server proxy forwards /api requests.
VITE_PROXY_TARGET=http://localhost:8080
